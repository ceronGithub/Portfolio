generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  BUYER
}

enum ProductCategory {
  weapon
  character
  interior
  exterior
}

enum OrderStatus {
  PENDING          // Inquiry submitted, awaiting downpayment
  PAID             // Downpayment received — development starts
  IN_DEVELOPMENT   // Actively being built
  IN_TESTING       // QA / UAT phase
  DELIVERED        // Handed over to buyer
  FAILED           // Payment failed or order cancelled
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(BUYER)
  isActive  Boolean  @default(true)
  isBanned  Boolean  @default(false)
  createdAt DateTime @default(now())

  orders    Order[]
  ownership Ownership[]
  reviews   Review[]
  inquiries Inquiry[]
}
model Product {
  id                String          @id @default(cuid())
  name              String
  description       String?
  price             Int
  category          ProductCategory @default(character)
  previewVideoUrl   String?
  facePngUrl        String?
  threeDUrl         String?
  actionOneUrl      String?
  actionTwoUrl      String?
  actionThreeUrl    String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  orders    Order[]
  ownership Ownership[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  productId       String
  status          OrderStatus @default(PENDING)
  paymongoOrderId String?
  amountPaid      Int?
  deliveryNote    String?     // Admin-set note for current stage
  estimatedAt     DateTime?   // Estimated delivery date
  deliveredAt     DateTime?   // Actual delivery timestamp
  createdAt       DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Ownership {
  id        String   @id @default(cuid())
  userId    String
  productId String
  grantedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}
// ── System catalog ─────────────────────────────────────────────────
// Stores all 10 systems with base pricing, features, and metadata.

model System {
  id           String        @id @default(cuid())
  tag          String        @unique  // "HR", "Construction", etc.
  title        String
  basePrice    Int                    // in PHP (e.g. 33000)
  accent       String                 // hex color
  timeline     String
  deploy       String
  description  String
  features     String[]               // base feature list
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  addons       SystemAddon[]
}

// ── System add-ons ─────────────────────────────────────────────────
// Each row is one purchasable add-on belonging to a System.

model SystemAddon {
  id          String   @id @default(cuid())
  addonKey    String              // original id e.g. "hr1", "co5"
  label       String
  price       Int                 // in PHP
  category    String
  description String?
  systemId    String
  createdAt   DateTime @default(now())

  system      System   @relation(fields: [systemId], references: [id])

  @@unique([systemId, addonKey])
  @@index([systemId])
}

// ── Reviews ────────────────────────────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  userId    String
  assetId   String   // asset slug e.g. "orc-01", "axe-03", "int-01"
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, assetId])
}

// ── Custom Inquiries ───────────────────────────────────────────────────────
model Inquiry {
  id            String   @id @default(cuid())
  userId        String
  assetType     String
  description   String
  animCount     Int?
  polyBudget    String?
  reference     String?
  deliverySpeed String
  estimatedQuote Int?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
