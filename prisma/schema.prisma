generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BUYER
}

enum ProductCategory {
  weapon
  character
  interior
  exterior
}

// Package tier for character/weapon assets.
// mesh_only  = OBJ + FBX (no animations)
// standard   = OBJ + FBX + 5 core animations
// full_pack  = OBJ + FBX + GLB + 7 animations
enum PackageTier {
  mesh_only
  standard
  full_pack
}

enum OrderStatus {
  PENDING          // Inquiry submitted, awaiting downpayment
  PAID             // Downpayment received — development starts
  IN_DEVELOPMENT   // Actively being built
  IN_TESTING       // QA / UAT phase
  DELIVERED        // Handed over to buyer
  FAILED           // Payment failed or order cancelled
  LINK_EXPIRED     // Payment link expired (24h passed, no payment made)
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(BUYER)
  isActive  Boolean  @default(true)
  isBanned  Boolean  @default(false)
  createdAt DateTime @default(now())

  orders    Order[]
  ownership Ownership[]
  reviews   Review[]
  inquiries          Inquiry[]
  maintenanceOrders  MaintenanceOrder[]
  appointments       Appointment[]
}
model Product {
  id                String          @id @default(cuid())
  slug              String?         @unique // Legacy asset slug (orc-01, axe-03, int-01, etc)
  name              String
  description       String?
  priceMeshOnly     Int             @default(0)   // mesh_only tier price
  priceStandard     Int             @default(0)   // standard tier price
  priceFullPack     Int             @default(0)   // full_pack tier price
  enabledTiers      String          @default("mesh_only,standard,full_pack") // comma-sep list of buyer-visible tiers
  category          ProductCategory @default(character)
  packageTier       PackageTier     @default(mesh_only)

  // ── Preview assets ────────────────────────────────────────────────
  previewVideoUrl   String?         // MP4 animation preview (GDrive proxy)
  facePngUrl        String?         // Face / thumbnail PNG

  // ── Downloadable mesh files (Supabase storage keys) ───────────────
  fileKeyObj        String?         // .obj mesh
  fileKeyFbx        String?         // .fbx rigged (all paid tiers)
  fileKeyGlb        String?         // .glb web/AR ready (full_pack only)

  // ── Animation clips FBX — standard + full_pack ────────────────────
  animIdleUrl       String?         // Idle loop
  animWalkUrl       String?         // Walk loop
  animRunUrl        String?         // Run loop
  animAttackOneUrl  String?         // Primary attack
  animAttackTwoUrl  String?         // Secondary attack (full_pack only)
  animDeathUrl      String?         // Death
  animHitUrl        String?         // Hit / Flinch (full_pack only)

  // ── Legacy action slots (weapon/arch records) ─────────────────────
  actionOneUrl      String?
  actionTwoUrl      String?
  actionThreeUrl    String?
  actionFourUrl     String?
  actionFiveUrl     String?
  actionSixUrl      String?
  actionSevenUrl    String?

  // ── 3D viewer URL (architecture) ──────────────────────────────────
  threeDUrl         String?

  // ── Drive ID map — JSON string { fieldName: driveFileId } ──────────
  // Tracks Drive IDs for files uploaded to both R2+Drive so delete can
  // purge the Drive copy even when only the R2 URL is stored on the field.
  mediaDriveIds     String?

  isLatest          Boolean         @default(false)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  orders    Order[]
  ownership Ownership[]
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  productId          String?     // nullable — set for 3D asset orders
  systemId           String?     // nullable — set for System orders
  status             OrderStatus @default(PENDING)
  paymongoOrderId    String?     // PayMongo link ID
  paymongoPaymentId  String?     // PayMongo payment ID — e.g. "pay_xxx" (set by webhook on payment)
  paymentStatus      String?     // PayMongo payment status — e.g. "paid" (set by webhook)
  paidAt             DateTime?   // Timestamp of payment confirmation (set by webhook)
  amountPaid         Int?
  deliveryNote       String?     // Admin-set note for current stage
  estimatedAt        DateTime?   // Estimated delivery date
  deliveredAt        DateTime?   // Actual delivery timestamp
  createdAt          DateTime    @default(now())

  user    User     @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  system  System?  @relation(fields: [systemId], references: [id])
}

model Ownership {
  id          String      @id @default(cuid())
  userId      String
  productId   String
  fileKey     String?     // Supabase storage key — set by admin after delivery
  grantedTier PackageTier @default(mesh_only) // Tier admin granted: mesh_only | standard | full_pack
  grantedAt   DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}
// ── System catalog ─────────────────────────────────────────────────
// Stores all 10 systems with base pricing, features, and metadata.

model System {
  id            String        @id @default(cuid())
  tag           String        @unique  // "HR", "Construction", etc.
  title         String
  basePrice     Int                    // in PHP (e.g. 33000) — used when pricing mode = "one_time"
  // Subscription pricing (optional) — used when pricing mode = "subscription".
  // Null on either field means this system has no subscription option; UI falls back to one-time only.
  setupFee      Int?                   // one-time setup fee for subscription mode, in PHP
  monthlyFee    Int?                   // recurring monthly fee for subscription mode, in PHP
  accent        String                 // hex color
  timeline      String
  deploy        String
  description   String
  features      String[]               // base feature list
  bgVideoUrl    String?                // background video for buyer UI
  demoVideoUrl  String?                // demo video shown in Configure modal
  isActive      Boolean       @default(true)
  // Admin-controlled display status for buyer + visitor views
  // visible = normal | coming_soon = locked badge | ongoing = in-dev badge | hidden = not shown at all
  displayStatus String        @default("visible")
  createdAt     DateTime      @default(now())

  addons       SystemAddon[]
  orders       Order[]
  designTiers  DesignTier[]
}

// ── System add-ons ─────────────────────────────────────────────────
// Each row is one purchasable add-on belonging to a System.

model SystemAddon {
  id          String   @id @default(cuid())
  addonKey    String              // original id e.g. "hr1", "co5"
  label       String
  // pricingType controls which price field(s) apply:
  //   "fixed" (default) → use `price` only, exact amount
  //   "range"            → use `priceMin`/`priceMax`, quote-based (e.g. complex custom integrations)
  pricingType String   @default("fixed")
  price       Int                 // in PHP — used when pricingType = "fixed"
  priceMin    Int?                // in PHP — used when pricingType = "range"
  priceMax    Int?                // in PHP — used when pricingType = "range"; null = open-ended ("50K+")
  category    String
  description String?
  systemId    String
  createdAt   DateTime @default(now())

  system      System   @relation(fields: [systemId], references: [id])

  @@unique([systemId, addonKey])
  @@index([systemId])
}

// ── Design Tiers ───────────────────────────────────────────────────
// Each system can have up to 4 design tiers (Static, Dynamic, Modern, AI-Powered).
// priceModifier is added on top of the system basePrice at checkout.
// sortOrder controls display sequence (0 = first).

model DesignTier {
  id            String   @id @default(cuid())
  systemId      String
  name          String                   // "Static" | "Dynamic" | "Modern" | "AI-Powered" OR "Tier 1 — Managed Rental"
  slug          String                   // "static" | "dynamic" | "modern" | "ai-powered" OR "tier-1-managed"
  tagline       String?                  // Short description shown under the name
  
  // ── Flexible Pricing Model (supports one-time, subscription, payment-plan) ──────
  pricingType   String   @default("one-time")  // enum-like: "one-time" | "subscription" | "payment-plan"
  
  // One-time pricing (used when pricingType = "one-time")
  basePrice     Int?                           // total one-time cost in PHP (e.g. 350000)
  
  // Subscription pricing (used when pricingType = "subscription")
  setupFee      Int?                           // one-time setup fee in PHP (e.g. 15000)
  monthlyFee    Int?                           // recurring monthly fee in PHP (e.g. 15000)
  minMonthsLock Int?  @default(3)              // minimum lock-in period (e.g. 3 months)
  
  // Payment plan pricing (used when pricingType = "payment-plan")
  installmentMonths  Int?                      // number of months to pay (e.g. 36)
  installmentAmount  Int?                      // monthly payment amount in PHP (e.g. 20000)
  
  // ── Legacy & metadata ──────────────────────────────────────────────────────────
  priceModifier Int      @default(0)     // LEGACY: Added to system basePrice (for backward compat)
  features      String[] @default([])    // This tier's own package details
  demoVideoUrl  String?                  // Tier-specific demo video
  liveUrl       String?                  // Live demo website link
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  system System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([systemId, slug])
  @@index([systemId])
  @@index([pricingType])
}

// ── Service Tiers ──────────────────────────────────────────────────
// Informational-only subscription/service tiers (e.g. Basic, Standard, Premium)
// shown inside the visitor Systems Showcase. NOT tied to checkout math or
// the configurator's price total — purely educational content so visitors
// understand what each service level roughly covers before inquiring.

model ServiceTier {
  id         String   @id @default(cuid())
  name       String              // "Basic" | "Standard" | "Premium"
  tagline    String?             // short description under the name
  priceLabel String?             // free-text display price, e.g. "₱10,000 – ₱30,000" — not used in calculations
  features   String[]            // bullet list of what this tier roughly includes
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

// ── Reviews ────────────────────────────────────────────────────────────────
model Review {
  id            String   @id @default(cuid())
  userId        String
  assetId       String   // asset slug e.g. "orc-01", "axe-03", "int-01"
  rating        Int
  comment       String?
  isHidden      Boolean  @default(false)   // Admin hide — hides from buyer/visitor
  isHighlighted Boolean  @default(false)   // Admin highlight — featured on visitor page
  isPinned      Boolean  @default(false)   // Admin pin — pinned to top
  adminReply    String?                    // Admin's reply to this review
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, assetId])
}

// ── Visitor Testimonials ───────────────────────────────────────────────────
// Submitted by visitors on the landing page. Admin can approve or delete.
model Testimonial {
  id            String   @id @default(cuid())
  name          String
  project       String
  rate          Int                        // 1–100 satisfaction percentage
  comment       String
  initials      String
  accent        String
  isApproved    Boolean  @default(false)   // Admin must approve before showing
  isHidden      Boolean  @default(false)   // Admin hide — hides from visitor/buyer
  isHighlighted Boolean  @default(false)   // Admin highlight — featured
  isPinned      Boolean  @default(false)   // Admin pin — pinned to top
  adminReply    String?                    // Admin's reply shown below the testimonial
  createdAt     DateTime @default(now())
}

// ── Contact Messages (General Inquiries from InquirySection) ──────────────
// Stores general Get-in-Touch form submissions from buyer/inquiries page.
// No auth required — stores contactName + contactEmail.
model ContactMessage {
  id          String   @id @default(cuid())
  contactName String
  email       String
  subject     String?
  message     String
  status      String   @default("new")   // new | read | replied
  createdAt   DateTime @default(now())
}

// ── Custom Inquiries ───────────────────────────────────────────────────────
model Inquiry {
  id            String   @id @default(cuid())
  userId        String
  assetType     String
  description   String
  animCount     Int?
  polyBudget    String?
  reference     String?
  deliverySpeed String
  estimatedQuote Int?
  adminQuote     Int?     // Admin's official quoted price — set/updated by admin anytime
  adminComment   String?  // Admin's comment / response on the request (legacy single-comment)
  buyerComment   String?  // Buyer's reply or additional notes on the request (legacy)
  status         String   @default("pending")
  createdAt     DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  comments InquiryComment[]
}

// ── Inquiry Comment Thread ─────────────────────────────────────────────────
// Threaded comments on a custom request. Admin posts comments; buyer can reply
// to each admin comment (parentId references the admin comment being replied to).
model InquiryComment {
  id         String   @id @default(cuid())
  inquiryId  String
  role       String                        // "ADMIN" | "BUYER"
  content    String
  parentId   String?                       // null = root admin comment; non-null = buyer reply to that comment
  createdAt  DateTime @default(now())

  inquiry Inquiry          @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  parent  InquiryComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies InquiryComment[] @relation("CommentReplies")

  @@index([inquiryId])
}

// ── Site Visits — one row per unique daily session ─────────────────────────
// fingerprint: SHA-256 of (IP + UA) — no raw PII stored
// date: "YYYY-MM-DD" — one record per fingerprint per day
model SiteVisit {
  id          String   @id @default(cuid())
  fingerprint String
  date        String
  createdAt   DateTime @default(now())

  @@unique([fingerprint, date])
}

// ── User Action Logs — audit trail for admin actions ──────────────────────
model UserActionLog {
  id            String   @id @default(cuid())
  action        String   // BAN | UNBAN | DEACTIVATE | ACTIVATE | DELETE
  targetUserId  String
  targetEmail   String
  targetName    String?
  adminId       String
  adminEmail    String
  reason        String?
  createdAt     DateTime @default(now())
}

// ── Maintenance & Support ──────────────────────────────────────────────────

// One active order per buyer at a time. package = BASIC | PRIORITY | FULL.
model MaintenanceOrder {
  id             String   @id @default(cuid())
  userId         String
  package        String                         // BASIC | PRIORITY | FULL
  status         String   @default("ACTIVE")   // ACTIVE | EXPIRED | CANCELLED
  bugsUsed       Int      @default(0)
  revisionsUsed  Int      @default(0)
  startedAt      DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id])
  vcSchedules VCSchedule[]
  bugReports  BugReport[]
  tasks       MaintenanceTask[]

  @@index([userId])
}

// ── Maintenance Plan Config ──────────────────────────────────────────────
// Seeded with 3 rows (BASIC, PRIORITY, FULL). Admin can update price/limits.
// Buyer UI reads from here so prices are always in sync.
model MaintenancePlan {
  id            String @id @default(cuid())
  package       String @unique  // BASIC | PRIORITY | FULL
  price         Int             // PHP
  bugLimit      Int
  revisionLimit Int
}

// VC call request — buyer or admin can initiate.
model VCSchedule {
  id                 String   @id @default(cuid())
  maintenanceOrderId String
  initiator          String                        // BUYER | ADMIN
  buyerName          String
  buyerPhone         String
  preferredDate      DateTime
  confirmedDate      DateTime?
  status             String   @default("PENDING") // PENDING | CONFIRMED | DONE | CANCELLED
  adminNote          String?
  createdAt          DateTime @default(now())

  order MaintenanceOrder @relation(fields: [maintenanceOrderId], references: [id])

  @@index([maintenanceOrderId])
}

// Bug report submitted by buyer. Admin classifies and resolves.
model BugReport {
  id                 String    @id @default(cuid())
  maintenanceOrderId String
  title              String
  description        String
  category           String?                        // MINOR | MODERATE | CRITICAL
  status             String    @default("SUBMITTED") // SUBMITTED | REVIEWING | IN_PROGRESS | RESOLVED | EXTRA_CHARGE
  adminNote          String?
  isExtraCharge      Boolean   @default(false)
  extraChargeAmount  Int?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  order MaintenanceOrder @relation(fields: [maintenanceOrderId], references: [id])

  @@index([maintenanceOrderId])
}

// Task added by admin for the client (revision, fix, other).
model MaintenanceTask {
  id                 String    @id @default(cuid())
  maintenanceOrderId String
  title              String
  description        String?
  type               String    @default("OTHER")    // REVISION | FIX | OTHER
  status             String    @default("PENDING")  // PENDING | IN_PROGRESS | DONE
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order MaintenanceOrder @relation(fields: [maintenanceOrderId], references: [id])

  @@index([maintenanceOrderId])
}
// ── Google OAuth Token ──────────────────────────────────────────────────
// Stores the Google Drive refresh token for the admin account.
// Single row — upserted on every successful OAuth callback.
// Permanent until manually revoked in Google Account settings.

model GoogleToken {
  id           String   @id @default("singleton")  // always "singleton" — one row only
  refreshToken String                               // never expires unless revoked
  accessToken  String?                              // cached, refreshed automatically
  accessExpiry DateTime?                            // when the cached access token expires
  updatedAt    DateTime @updatedAt
}

// ── Appointments ────────────────────────────────────────────────────────────
// Created when a buyer schedules a consultation for a system.
// Stores a snapshot of the system, selected add-ons, and quoted price.

enum AppointmentStatus {
  PENDING      // Just submitted — awaiting developer acknowledgment
  SCHEDULED    // VC confirmed by developer
  COMPLETED    // VC done — moving to proposal / DP
  CANCELLED
}

model Appointment {
  id             String            @id @default(cuid())
  createdAt      DateTime          @default(now())

  // Buyer info
  buyerName      String
  buyerEmail     String

  // System snapshot at time of request
  systemId       String
  systemTitle    String
  basePrice      Int
  selectedAddons Json              // [{ id, label, price }]
  quotedPrice    Int               // basePrice + addons total

  // Scheduling
  scheduledDate  String            // ISO date string (YYYY-MM-DD), minimum +1 day from createdAt
  message        String?           // optional buyer note

  // Tracking
  referenceNo    String            @unique
  status         AppointmentStatus @default(PENDING)
  adminNote      String?           // admin-only note
  deletedAt      DateTime?         // soft delete — buyer-removed PENDING appointments (Rule 6 standard)

  // Relation
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  comments       AppointmentComment[]

  @@index([userId])
  @@index([status])
}

// ── Appointment Comment Thread ─────────────────────────────────────────────
model AppointmentComment {
  id            String   @id @default(cuid())
  appointmentId String
  role          String                        // "ADMIN" | "BUYER"
  content       String
  parentId      String?                       // null = root; non-null = reply
  createdAt     DateTime @default(now())

  appointment Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  parent      AppointmentComment?  @relation("ApptCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     AppointmentComment[] @relation("ApptCommentReplies")

  @@index([appointmentId])
}
